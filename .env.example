# Copy this file to .env and fill in your values.

# ESPN Fantasy Football
ESPN_LEAGUE_ID=
ESPN_SEASON=
ESPN_SWID=
ESPN_S2=

# Anthropic (unused while agent/chat.py is running on OpenRouter — see below)
ANTHROPIC_API_KEY=
# Optional, defaults to claude-opus-5
ANTHROPIC_MODEL=

# OpenRouter — agent/chat.py currently uses this
OPENROUTER_API_KEY=
# Optional, defaults to qwen/qwen3.7-flash
OPENROUTER_MODEL=

# RSS feeds for NFL news ingestion (comma-separated URLs)
RSS_FEED_URLS=
