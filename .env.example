# Optional. Everything here can also be set from the app's Setup page, which writes
# to data/settings.json and takes precedence over this file. Use .env for headless or
# container setups where there's no browser to run the Setup page.

# ESPN Fantasy Football
# Public leagues need only ESPN_LEAGUE_ID and ESPN_SEASON.
ESPN_LEAGUE_ID=
ESPN_SEASON=

# Private leagues only: DevTools -> Application -> Cookies -> fantasy.espn.com
ESPN_SWID=
ESPN_S2=

# Optional. Which team is yours — required for public leagues, since there are no
# cookies to match against. Overrides SWID-based detection when set.
ESPN_TEAM_ID=

# OpenRouter — needed for the Oracle chat page only.
OPENROUTER_API_KEY=
# Optional, defaults to qwen/qwen3.7-flash
OPENROUTER_MODEL=

# Optional. Comma-separated NFL news RSS feeds; a sensible default set is built in.
RSS_FEED_URLS=

# Optional. Where db.sqlite, the Chroma store, and settings.json live.
# Defaults to ./data — point it at a mounted volume when containerised.
DATA_DIR=

# Optional. Set this and the app uses Postgres instead of the local data/db.sqlite
# file — that's how the hosted build points at Supabase. Leave it unset and nothing
# external is needed, which is the default for self-hosting.
#
# Supabase: Project Settings -> Database -> Connection string -> URI. Prefer the
# pooled connection (port 6543) over the direct one (5432), since the app opens a
# connection per request.
#
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>:6543/postgres
#
# Apply supabase/migrations/*.sql first, then copy an existing SQLite database over
# with: python3 scripts/migrate_to_postgres.py
DATABASE_URL=
