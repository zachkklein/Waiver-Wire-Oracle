# Optional. Everything here can also be set from the app's Setup page, which writes
# to data/settings.json and takes precedence over this file. Use .env for headless or
# container setups where there's no browser to run the Setup page.

# ESPN Fantasy Football
# Public leagues need only ESPN_LEAGUE_ID and ESPN_SEASON.
ESPN_LEAGUE_ID=
ESPN_SEASON=

# Private leagues only: DevTools -> Application -> Cookies -> fantasy.espn.com
ESPN_SWID=
ESPN_S2=

# Optional. Which team is yours — required for public leagues, since there are no
# cookies to match against. Overrides SWID-based detection when set.
ESPN_TEAM_ID=

# OpenRouter — needed for the Oracle chat page only.
OPENROUTER_API_KEY=
# Optional, defaults to qwen/qwen3.7-flash
OPENROUTER_MODEL=

# Optional. Comma-separated NFL news RSS feeds; a sensible default set is built in.
RSS_FEED_URLS=

# Optional. Where db.sqlite, the Chroma store, and settings.json live.
# Defaults to ./data — point it at a mounted volume when containerised.
DATA_DIR=

# Optional. Set this and the app uses Postgres instead of the local data/db.sqlite
# file — that's how the hosted build points at Supabase. Leave it unset and nothing
# external is needed, which is the default for self-hosting.
#
# Supabase: Project Settings -> Database -> Connection string -> URI. Prefer the
# pooled connection (port 6543) over the direct one (5432), since the app opens a
# connection per request.
#
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>:6543/postgres
#
# Apply supabase/migrations/*.sql first, then copy an existing SQLite database over
# with: python3 scripts/migrate_to_postgres.py
DATABASE_URL=

# ---------------------------------------------------------------------------
# Accounts (the hosted build). Leave these unset for a self-hosted install:
# without them there is no sign-in screen, and the app is the single-user tool
# it has always been, reading its league from data/settings.json.
#
# Set them and every request must carry a Supabase Auth JWT, and a user's
# leagues come from the user_leagues table instead. DATABASE_URL must also be
# set — accounts live in Postgres — and the server refuses to start otherwise.
#
# This app uses Supabase's current key system, not the legacy keys:
#
#   * The PUBLISHABLE key (Project Settings -> API Keys), which starts with
#     `sb_publishable_`. It is public by design — the app serves it straight to
#     the browser from GET /api/auth/config, so one frontend build works for
#     both deployments. The legacy `anon` key (a long `eyJ...` JWT) is rejected
#     at startup: it would work, which is exactly why it's worth catching.
#
#   * JWT SIGNING KEYS (Authentication -> JWT Keys) — asymmetric ES256/RS256,
#     published at the project's JWKS endpoint. Tokens are verified against
#     those, and there is deliberately no SUPABASE_JWT_SECRET: a shared secret
#     that can verify a token can also mint one, and nothing here needs to.
#
#   * No SECRET (service-role) key, anywhere. The backend reaches the database
#     over DATABASE_URL as the table owner and never calls PostgREST, so it has
#     nothing to authenticate to.
#
# One dashboard step is needed as well: Authentication -> URL Configuration,
# add your site's URL to the redirect allow-list, or magic links will bounce.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
